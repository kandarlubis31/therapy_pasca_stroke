---
// src/components/Stats.astro
---
<div class="stats-bar" id="statsBar" role="region" aria-label="Statistik latihan">
    <div class="stats-bar-inner">
        <div class="stats-bar-counts">
            <div class="stat-pill">
                <span class="stat-pill-icon">🔤</span>
                <span class="stat-pill-label">Huruf</span>
                <span class="stat-pill-val" id="statAlpha">0</span>
            </div>
            <div class="stat-pill">
                <span class="stat-pill-icon">📖</span>
                <span class="stat-pill-label">Kata</span>
                <span class="stat-pill-val" id="statWords">0</span>
            </div>
            <div class="stat-pill">
                <span class="stat-pill-icon">💬</span>
                <span class="stat-pill-label">Kalimat</span>
                <span class="stat-pill-val" id="statSent">0</span>
            </div>
            <div class="stat-pill">
                <span class="stat-pill-icon">💪</span>
                <span class="stat-pill-label">Fisik</span>
                <span class="stat-pill-val" id="statOralMotor">0</span>
            </div>
            <div class="stat-pill">
                <span class="stat-pill-icon">⭐</span>
                <span class="stat-pill-label">Kustom</span>
                <span class="stat-pill-val" id="statCustom">0</span>
            </div>
            <div class="stat-pill highlight">
                <span class="stat-pill-icon">🎯</span>
                <span class="stat-pill-label">Total</span>
                <span class="stat-pill-val" id="totalToday">0</span>
            </div>
        </div>
        <div class="stats-bar-progress">
            <div class="progress-bar-container">
                <div class="progress-bar" id="progressBar" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="20" aria-label="Progres latihan hari ini"></div>
            </div>
            <div class="stats-progress-footer">
                <button class="btn-restart" onclick="window.resetProgress()">↻ Reset</button>
                <div class="progress-text" id="progressText">0 / 20</div>
            </div>
        </div>
    </div>
</div>

<style>
    .stats-progress-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 3px;
        gap: 8px;
    }

    .btn-restart {
        background: none;
        border: none;
        color: var(--accent-peach);
        font-size: 0.6rem;
        font-weight: 700;
        cursor: pointer;
        padding: 0.15rem 0.35rem;
        border-radius: 4px;
        transition: all 0.2s ease;
        flex-shrink: 0;
        opacity: 0.7;
        font-family: var(--font-main);
    }

    .btn-restart:hover {
        opacity: 1;
        background: rgba(229, 140, 106, 0.1);
    }

    .btn-restart:active {
        transform: scale(0.93);
        background: rgba(229, 140, 106, 0.2);
    }

    .stat-pill-icon {
        font-size: 0.7rem;
        line-height: 1;
    }

    @media (min-width: 768px) {
        .stat-pill-icon {
            font-size: 0.8rem;
        }
    }
</style>
