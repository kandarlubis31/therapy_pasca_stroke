---
// src/layouts/Layout.astro
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="id" dir="ltr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=3.0">
    <title>PulihBicara — Terapi Wicara Pasca Stroke</title>
    <meta name="description" content="PulihBicara adalah aplikasi terapi wicara pasca stroke. Latihan bicara, napas, dan kosa kata untuk pemulihan komunikasi.">
    <meta name="keywords" content="terapi wicara, pasca stroke, latihan bicara, afasia, rehabilitasi, bahasa Indonesia, PulihBicara">
    <meta name="author" content="PulihBicara">
    <meta name="robots" content="index, follow">

    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#4A827B">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1A1D1C">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <meta name="apple-mobile-web-app-title" content="PulihBicara">
    <link rel="apple-touch-icon" href="/icons/icon-192.svg">
    <meta name="mobile-web-app-capable" content="yes">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <noscript><link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,700&display=swap" rel="stylesheet"></noscript>
</head>
<body>
    <!-- Offline indicator banner -->
    <div class="offline-banner" id="offlineBanner" role="alert" aria-hidden="true">
        <span class="offline-banner-icon">📡</span>
        <span class="offline-banner-text">Kamu sedang offline</span>
    </div>
    <!-- Skip-to-content link for keyboard & screen reader users -->
    <a class="skip-link" href="#main-content">Lompat ke konten utama</a>
    <!-- Live region for screen reader announcements -->
    <div id="ariaAnnouncer" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></div>
    <main id="main-content">
        <slot />
    </main>
    <script>
        // Expose screen reader announcer globally
        window.announceToScreenReader = function(message) {
            const el = document.getElementById('ariaAnnouncer');
            if (el) {
                el.textContent = '';
                setTimeout(() => { el.textContent = message; }, 50);
            }
        };

        // Disable horizontal scroll/swipe di mobile
        let lastTouchX = 0;
        let lastTouchY = 0;
        
        document.addEventListener('touchstart', (e) => {
            lastTouchX = e.touches[0].clientX;
            lastTouchY = e.touches[0].clientY;
        }, { passive: true });
        
        document.addEventListener('touchmove', (e) => {
            const touch = e.touches[0];
            const deltaX = Math.abs(touch.clientX - lastTouchX);
            const deltaY = Math.abs(touch.clientY - lastTouchY);
            const overlay = document.getElementById('cameraOverlay');
            
            if (deltaX > deltaY && deltaX > 10) {
                if (!overlay || !overlay.classList.contains('open') || !overlay.contains(e.target)) {
                    e.preventDefault();
                }
            }
        }, { passive: false });

        // Draggable camera overlay — FREE DRAG
        (() => {
            var overlay = document.getElementById('cameraOverlay');
            if (!overlay) return;
            
            var isDragging = false;
            var startX = 0, startY = 0;
            var startLeft = 0, startTop = 0;
            var posLeft = -1, posTop = -1;
            
            function getX(e) { return e.touches ? e.touches[0].clientX : e.clientX; }
            function getY(e) { return e.touches ? e.touches[0].clientY : e.clientY; }
            
            window.__cameraResetPosition = function() {
                posLeft = -1; posTop = -1;
                overlay.style.left = '';
                overlay.style.top = '';
                overlay.style.right = '';
            };
            
            function onPointerDown(e) {
                if (!overlay.classList.contains('open')) return;
                startX = getX(e); startY = getY(e);
                if (posLeft === -1) {
                    var rect = overlay.getBoundingClientRect();
                    startLeft = rect.left; startTop = rect.top;
                } else {
                    startLeft = posLeft; startTop = posTop;
                }
                isDragging = true;
                overlay.classList.add('dragging');
            }
            
            function onPointerMove(e) {
                if (!isDragging) return;
                var dx = getX(e) - startX;
                var dy = getY(e) - startY;
                var newLeft = startLeft + dx;
                var newTop = startTop + dy;
                var w = overlay.offsetWidth;
                var h = overlay.offsetHeight;
                newLeft = Math.max(0, Math.min(newLeft, window.innerWidth - w));
                newTop = Math.max(0, Math.min(newTop, window.innerHeight - h));
                posLeft = newLeft; posTop = newTop;
                overlay.style.right = '';
                overlay.style.left = newLeft + 'px';
                overlay.style.top = newTop + 'px';
                e.preventDefault();
            }
            
            function onPointerUp() {
                if (!isDragging) return;
                isDragging = false;
                overlay.classList.remove('dragging');
            }
            
            overlay.addEventListener('touchstart', onPointerDown, { passive: true });
            document.addEventListener('touchmove', onPointerMove, { passive: false });
            document.addEventListener('touchend', onPointerUp);
            overlay.addEventListener('mousedown', onPointerDown);
            document.addEventListener('mousemove', onPointerMove);
            document.addEventListener('mouseup', onPointerUp);
            overlay.addEventListener('dragstart', function(e) { e.preventDefault(); });
        })();
    </script>
    <script>
    // ── Online / Offline detection ──────────
    (() => {
        const banner = document.getElementById('offlineBanner');
        if (!banner) return;
        
        let offlineTimer = null;
        
        function showOffline() {
            clearTimeout(offlineTimer);
            banner.classList.add('show');
            banner.setAttribute('aria-hidden', 'false');
            if (window.announceToScreenReader) {
                window.announceToScreenReader('Koneksi terputus. Aplikasi tetap bisa digunakan secara offline.');
            }
        }
        
        function hideOffline() {
            offlineTimer = setTimeout(() => {
                banner.classList.remove('show');
                banner.setAttribute('aria-hidden', 'true');
                if (window.announceToScreenReader) {
                    window.announceToScreenReader('Koneksi kembali tersedia.');
                }
            }, 1500); // Delay 1.5s before hiding — debounce flaky connections
        }
        
        // Initial state
        if (!navigator.onLine) showOffline();
        
        window.addEventListener('online', hideOffline);
        window.addEventListener('offline', showOffline);
    })();

    // ── Service Worker registration ─────────
    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('/sw.js').then(reg => {
          console.log('SW registered:', reg.scope);
        }).catch(err => {
          console.log('SW registration failed:', err);
        });
      });
    }
    </script>
</body>
</html>
